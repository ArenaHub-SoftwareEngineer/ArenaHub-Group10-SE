{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/core.test.ts tests/chat-history.test.ts tests/player-calendar.test.ts tests/game-ranks.test.ts tests/fair-play.test.ts tests/stream.test.ts tests/broadcasts.test.ts tests/standings.test.ts tests/operations.test.ts tests/auth-flow.test.ts tests/institution-config.test.mjs",
    "test:auth-flow": "node --test tests/auth-flow.integration.test.mjs",
    "test:rules": "node --test tests/firestore.rules.test.mjs tests/operations.rules.test.mjs",
    "test:video-api": "tsx --test tests/fair-play-api.test.ts",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:api": "tsx --test tests/api.test.ts",
    "test:stream": "node --test tests/stream.integration.test.mjs",
    "test:storage": "node --test tests/evidence.storage.test.mjs",
    "configure:institution": "node scripts/sync-institution.mjs",
    "prebuild": "node scripts/sync-institution.mjs",
    "predev": "node scripts/sync-institution.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
