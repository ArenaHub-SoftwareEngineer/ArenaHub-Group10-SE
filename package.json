{
  "name": "arenahub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean-dist.mjs",
    "lint": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/core.test.ts tests/chat-history.test.ts tests/player-calendar.test.ts tests/game-ranks.test.ts tests/fair-play.test.ts tests/stream.test.ts tests/broadcasts.test.ts tests/standings.test.ts tests/operations.test.ts tests/auth-flow.test.ts tests/institution-config.test.mjs tests/no-emoji.test.ts tests/tournament-docs.test.ts tests/integrity-risk.test.ts tests/integrity-agent.test.ts tests/chat-moderation.test.ts tests/placement.test.ts tests/bracket-studio.test.ts tests/match-highlights.test.ts tests/ai-eval.test.ts",
    "test:auth-flow": "node --test tests/auth-flow.integration.test.mjs",
    "test:rules": "node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/operations.rules.test.mjs tests/data.rules.test.mjs tests/chat.rules.test.mjs",
    "test:video-api": "tsx --test tests/fair-play-api.test.ts",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:api": "tsx --test tests/api.test.ts",
    "test:stream": "node --test tests/stream.integration.test.mjs",
    "test:storage": "node --test tests/evidence.storage.test.mjs",
    "configure:institution": "node scripts/sync-institution.mjs",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/sync-institution.mjs",
    "predev": "node scripts/sync-institution.mjs",
    "test:emulators": "node tests/run-emulator-suites.mjs",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-arenahub --config firebase.test.json \"node tests/seed-emulators.mjs && npx tsx scripts/seed-demo.ts && npx playwright test\"",
    "test:all": "npm run lint && npm test && npm run test:api && npm run test:video-api && npm run test:integrity-api && npm run build && npm run test:emulators",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "set-role": "node scripts/set-role.mjs",
    "smoke": "node scripts/smoke.mjs",
    "migrate:brackets": "tsx scripts/migrate-brackets.ts",
    "test:integrity-api": "tsx --test tests/integrity-api.test.ts",
    "agent": "tsx tools/integrity-agent/agent.ts",
    "build:agent": "node scripts/build-agent.mjs",
    "build:companion": "node scripts/build-companion.mjs",
    "online": "node scripts/online.mjs",
    "demo": "node scripts/demo.mjs",
    "audit:contrast": "node scripts/contrast-audit.cjs",
    "postbuild": "node scripts/check-production-build.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "14.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
