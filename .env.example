# ArenaHub — Environment Variables
#
# Copy this file to .env and fill in your Firebase project values.
# Never commit .env to version control.

# ── Firebase ───────────────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ── Arena AI (server only; never prefix these with VITE_) ─────────────────────
# Without any model key, Arena AI answers from the live records only.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Tried in order; a model that writes nothing within AI_FIRST_TOKEN_MS is skipped.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   ("none" to disable)
# AI_FIRST_TOKEN_MS=12000
# Modes the viewer picks (Quick, Think, Deep). Comma-separated Gemini models, tried in order:
# AI_QUICK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# AI_THINK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# AI_DEEP_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Thinking tokens per model call:
# AI_THINK_BUDGET=2048
# AI_DEEP_BUDGET=8192
# Allowance per person: model tokens per window (a Think answer measured about 9,000 tokens).
# AI_WINDOW_TOKENS=400000
# AI_WINDOW_HOURS=5
# AI_STAFF_MULTIPLIER=2
# Optional backup model:
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Limits (defaults shown):
# AI_USER_PER_MINUTE=5
# AI_GLOBAL_PER_MINUTE=12
# AI_CHAT_USER_INTERVAL_SEC=30
# AI_CHAT_MATCH_PER_MINUTE=6

# ── Server access to Firebase (optional; see docs/DEPLOY.md) ──────────────────
# A service account enables revocation checks, Firestore rate limits and @Arena replies in chat.
# Use ONE of these. Keep the key file outside the project folder.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/arenahub-api.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional vision-capable model override for organizer video evidence review.
# GEMINI_VIDEO_MODEL=gemini-3.6-flash

# ── Separate API host (optional; see docs/DEPLOY.md and docs/ENV_CHECKLIST.md) ──
# Website build: where the browser sends /api calls. Empty means the same origin.
VITE_API_BASE_URL=
# API host: website origins allowed to call it, comma-separated, https only.
CORS_ORIGINS=

# Hosted match monitor: persistent Node server with private disk (not api/index.ts serverless).
# Public API origin; HTTPS required. Do not combine with INTEGRITY_PUBLIC_URL (player-only tunnel).
# INTEGRITY_HOSTED_URL=https://api.example.org
# INTEGRITY_DATA_DIR=/private-volume/integrity
# INTEGRITY_DOWNLOAD_DIR=/app/dist-agent
# HOST=0.0.0.0
# PORT=3210
