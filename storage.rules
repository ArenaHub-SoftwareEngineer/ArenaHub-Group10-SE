rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // BEGIN INSTITUTION POLICY (generated by npm run configure:institution)
    function institutionalEmail(email) {
      return email is string && email.lower().matches('[^@]+@wmsu[.]edu[.]ph');
    }
    function acceptedGoogleIdentity() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'google.com'
        || (request.auth.token.get('email_verified', false) == true && institutionalEmail(request.auth.token.get('email', '')));
    }
    // END INSTITUTION POLICY
    function active() {
      return request.auth != null && acceptedGoogleIdentity() && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function staff() { return active() && (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') in ['admin', 'organizer', 'school-admin', 'moderator']); }
    // Broadcast thumbnails are public pictures on match cards; only staff upload them.
    match /broadcastThumbnails/{matchId}/{fileId} {
      allow read: if true;
      allow create: if staff() && request.resource.size > 0 && request.resource.size <= 5242880
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    match /integrityEvidence/{uid}/{caseId}/{fileId} {
      allow read: if active() && (request.auth.uid == uid || staff());
      allow create: if active() && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/integrityCases/$(caseId))
        && request.resource.size > 0 && request.resource.size <= 104857600
        && request.resource.contentType.matches('(image/(png|jpeg|webp)|video/(mp4|webm))');
      // Submitted evidence is immutable; unfinished uploads may be removed by their owner.
      allow delete: if active() && request.auth.uid == uid && !firestore.exists(/databases/(default)/documents/integrityCases/$(caseId));
    }
  }
}
