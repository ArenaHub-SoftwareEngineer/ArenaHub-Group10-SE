{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist-vercel",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "public/{join.html,arenahub-logo.svg,fonts/**,pov.html,pov.js,pov.css,vendor/livekit-client.umd.js}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
