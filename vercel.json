{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist-vercel",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "public/{join.html,arenahub-logo.svg,fonts/**,pov.html,pov.js,pov.css,vendor/livekit-client.umd.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://apis.google.com https://accounts.google.com https://www.gstatic.com https://www.google.com https://www.recaptcha.net 'sha256-rCUEdW/Tm3Tg/CUkAnGukEDZmy7VKwjui6DyHYR3nLg='; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!api(?:/|$)|join|pov\\.|vendor/|fonts/|arenahub-logo\\.svg).*)",
      "destination": "https://arenahub-esports.web.app/$1",
      "permanent": false
    }
  ]
}
