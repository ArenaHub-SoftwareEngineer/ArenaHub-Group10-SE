rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BEGIN INSTITUTION POLICY (generated by npm run configure:institution)
    function institutionalEmail(email) {
      return email is string && email.lower().matches('[^@]+@wmsu[.]edu[.]ph');
    }
    function acceptedGoogleIdentity() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'google.com'
        || (request.auth.token.get('email_verified', false) == true && institutionalEmail(request.auth.token.get('email', '')));
    }
    // END INSTITUTION POLICY
    function signedIn() { return request.auth != null && acceptedGoogleIdentity(); }
    function ownsProfile(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isStaff() { return signedIn() && (isAdmin() || request.auth.token.get('role', '') in ['admin', 'organizer', 'school-admin', 'moderator']); }
    function activeAccount() { return signedIn() && request.auth.token.get('email_verified', false) == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'; }
    // "Arena AI" is reserved for server-posted assistant replies.
    function reservedChatName(name) { return name is string && name.lower().matches('[^a-z0-9]*arena[^a-z0-9]*ai[^a-z0-9]*'); }
    function safeProfileCreate(uid) {
      return ownsProfile(uid) && request.resource.data.uid == uid
        && !reservedChatName(request.resource.data.get('name', ''))
        && request.resource.data.role == 'user' && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(['spectatorInviteApproved'])
        && request.resource.data.emailVerified == request.auth.token.get('email_verified', false);
    }
    function safeProfileUpdate(uid) {
      return ownsProfile(uid)
        && !reservedChatName(request.resource.data.get('name', ''))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'status', 'eventPassCode', 'joinedAt', 'spectatorInviteApproved'])
        && (request.resource.data.email == resource.data.email || request.resource.data.email == request.auth.token.get('email', ''))
        && request.resource.data.emailVerified == request.auth.token.get('email_verified', false);
    }
    match /users/{uid} {
      allow read: if ownsProfile(uid) || isAdmin();
      allow create: if safeProfileCreate(uid) || (ownsProfile(uid) && isAdmin());
      allow update: if safeProfileUpdate(uid) || isAdmin();
      allow delete: if false;
    }
    function campusStudent() {
      return activeAccount() && request.auth.token.email is string
        && institutionalEmail(request.auth.token.email);
    }
    function registeredStudent() {
      return campusStudent() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('spectatorInviteApproved', false) == true;
    }
    function personalSpectator() {
      return activeAccount() && !campusStudent()
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }
    function validInvite(token, invite) {
      let slot = get(/databases/$(database)/documents/studentInviteSlots/$(invite.issuer)).data;
      let issuer = get(/databases/$(database)/documents/users/$(invite.issuer)).data;
      return token.matches('[a-f0-9]{48}') && slot.token == token
        && invite.createdAt == slot.createdAt
        && request.time < invite.createdAt + duration.value(20, 'm')
        && issuer.status == 'active' && issuer.get('spectatorInviteApproved', false) == true
        && issuer.emailVerified == true && institutionalEmail(issuer.email);
    }
    function activeSpectator() {
      return personalSpectator()
        && get(/databases/$(database)/documents/spectatorAdmissions/$(request.auth.uid)).data.email == request.auth.token.email;
    }
    match /studentInviteSlots/{uid} {
      allow get: if ownsProfile(uid) && registeredStudent();
      allow create, update: if ownsProfile(uid) && registeredStudent()
        && (resource == null || request.time >= resource.data.createdAt + duration.value(20, 'm'))
        && request.resource.data.keys().hasOnly(['token', 'createdAt'])
        && request.resource.data.token is string && request.resource.data.token.matches('[a-f0-9]{48}')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/campusInvites/$(request.resource.data.token)).data.issuer == uid
        && getAfter(/databases/$(database)/documents/campusInvites/$(request.resource.data.token)).data.createdAt == request.time;
    }
    match /campusInvites/{token} {
      allow get: if validInvite(token, resource.data);
      allow create: if registeredStudent() && token.matches('[a-f0-9]{48}')
        && request.resource.data.keys().hasOnly(['issuer', 'createdAt'])
        && request.resource.data.issuer == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/studentInviteSlots/$(request.auth.uid)).data.token == token
        && getAfter(/databases/$(database)/documents/studentInviteSlots/$(request.auth.uid)).data.createdAt == request.time;
      allow delete: if registeredStudent() && resource.data.issuer == request.auth.uid
        && request.time >= resource.data.createdAt + duration.value(20, 'm');
    }
    match /spectatorAdmissions/{uid} {
      allow get: if ownsProfile(uid);
      allow create, update: if ownsProfile(uid) && personalSpectator()
        && request.resource.data.keys().hasOnly(['email', 'invite', 'admittedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.admittedAt == request.time
        && request.resource.data.invite is string
        && validInvite(request.resource.data.invite,
          get(/databases/$(database)/documents/campusInvites/$(request.resource.data.invite)).data);
    }
    // Legacy single-document stores, kept readable so a rollback still works. All writes use the collections below.
    match /arenahub/{legacy} {
      allow read: if campusStudent() || activeSpectator();
      allow write: if false;
    }
    // Battle Royale placement scoring: one lobby of up to 25 squads, up to 24 games. No player data.
    function validPlacement(p) {
      return p is map && p.keys().hasOnly(['config', 'teams', 'games'])
        && p.config is map && p.config.keys().hasOnly(['pointsTable', 'killPoints'])
        && p.config.pointsTable is list && p.config.pointsTable.size() >= 1 && p.config.pointsTable.size() <= 25
        && p.config.killPoints is int && p.config.killPoints >= 0 && p.config.killPoints <= 10
        && p.teams is list && p.teams.size() >= 2 && p.teams.size() <= 25
        && p.games is list && p.games.size() >= 1 && p.games.size() <= 24;
    }
    // One document per published bracket. Every update must raise the revision by exactly one,
    // so two organizers cannot silently overwrite each other.
    function validTournament(data, id) {
      return data.keys().hasOnly(['id', 'title', 'gameId', 'gameName', 'gameKey', 'format', 'matchFormat', 'teamsCount', 'seedingRule', 'createdAt', 'status', 'revision', 'featured', 'demo', 'matches', 'placement', 'updatedAt'])
        && (!data.keys().hasAny(['placement']) || validPlacement(data.placement))
        && data.id == id && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.gameKey is string && data.gameKey.size() > 0 && data.gameKey.size() <= 80
        && data.status in ['published', 'archived', 'unpublished']
        && data.revision is int && data.revision >= 1
        && data.matches is list && data.matches.size() <= 1100
        && data.featured is bool && data.updatedAt == request.time;
    }
    match /tournaments/{id} {
      allow read: if (admitted() && resource.data.status == 'published') || activeStaff();
      allow create: if activeStaff() && validTournament(request.resource.data, id);
      allow update: if activeStaff() && validTournament(request.resource.data, id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.gameKey == resource.data.gameKey;
      allow delete: if false;
      // Public roster: IGN, role and rank only.
      match /public/rosters {
        allow read: if admitted();
        allow write: if activeStaff() && request.resource.data.keys().hasOnly(['teams'])
          && request.resource.data.teams is list && request.resource.data.teams.size() <= 256;
      }
      // Full names, student IDs, school emails and sections. Staff only.
      match /private/roster {
        allow read, write: if activeStaff();
      }
    }
    match /publications/{key} {
      allow read: if activeStaff();
      allow write: if activeStaff()
        && request.resource.data.keys().hasOnly(['gameKey', 'currentId', 'hasPrevious', 'revision', 'updatedAt'])
        && request.resource.data.gameKey == key && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time;
      match /previous/{part} {
        allow read, write: if activeStaff() && part in ['tournament', 'rosters'];
      }
    }
    match /config/catalog {
      allow read: if admitted();
      allow write: if activeStaff() && request.resource.data.keys().hasOnly(['games', 'categories', 'updatedAt'])
        && request.resource.data.games is list && request.resource.data.games.size() <= 100
        && request.resource.data.categories is list && request.resource.data.categories.size() <= 100
        && request.resource.data.updatedAt == request.time;
    }
    match /featured/{id} {
      allow read: if admitted();
      allow create: if activeStaff()
        && request.resource.data.keys().hasOnly(['kind', 'title', 'link', 'author', 'isFeatured', 'createdAt'])
        && request.resource.data.kind in ['highlight', 'post']
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.link is string && request.resource.data.link.size() <= 500 && request.resource.data.link.matches('https://[^@ ]+')
        && request.resource.data.author is string && request.resource.data.author.size() >= 2 && request.resource.data.author.size() <= 80
        && request.resource.data.isFeatured == false && request.resource.data.createdAt == request.time;
      allow update: if activeStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFeatured'])
        && request.resource.data.isFeatured is bool;
      allow delete: if activeStaff();
    }
    match /users/{uid}/drafts/{draftId} {
      allow read, delete: if ownsProfile(uid) && activeStaff();
      allow create, update: if ownsProfile(uid) && activeStaff()
        && request.resource.data.keys().hasOnly(['draft', 'savedAt'])
        && request.resource.data.draft.id == draftId && request.resource.data.savedAt == request.time;
    }
    // ---- Live match chat ----
    // Every staff moderation write names an audit event created in the same batch.
    function auditedNow(auditId) {
      return auditId is string && auditId.size() > 0 && auditId.size() <= 100
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.actorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.createdAt == request.time;
    }
    function chatSlowModeSec(matchId) {
      let state = /databases/$(database)/documents/matchChat/$(matchId);
      return exists(state) ? get(state).data.slowModeSec : 0;
    }
    function chatMuted(matchId) {
      let mute = /databases/$(database)/documents/matchChat/$(matchId)/mutes/$(request.auth.uid);
      return exists(mute) && request.time < get(mute).data.until;
    }
    function validPin(matchId, p) {
      return p == null || (p is map && p.keys().hasOnly(['messageId', 'author', 'text'])
        && p.messageId is string && p.messageId.size() > 0 && p.messageId.size() <= 100
        && p.author is string && p.author.size() <= 80 && p.text is string && p.text.size() <= 500
        && get(/databases/$(database)/documents/matchChat/$(matchId)/messages/$(p.messageId)).data.text == p.text);
    }
    // Chat state: slow mode and the pinned message. Staff only, always audited.
    match /matchChat/{matchId} {
      allow get: if admitted();
      allow create, update: if activeStaff()
        && request.resource.data.keys().hasOnly(['slowModeSec', 'pinned', 'updatedBy', 'auditId', 'updatedAt'])
        && request.resource.data.slowModeSec in [0, 10, 30, 60, 120]
        && validPin(matchId, request.resource.data.pinned)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && auditedNow(request.resource.data.auditId);
    }
    match /matchChat/{matchId}/messages/{messageId} {
      allow read: if campusStudent() || activeSpectator();
      allow create: if campusStudent()
        && request.resource.data.keys().hasOnly(['author', 'text', 'createdAt', 'badge'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.author is string
        && request.resource.data.author.matches('[^@]{1,80}')
        && !reservedChatName(request.resource.data.author)
        && (request.resource.data.author == 'Anonymous'
          || request.resource.data.author == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name)
        // The staff badge is checked against the token role, never the profile.
        && (!request.resource.data.keys().hasAny(['badge']) || (request.resource.data.badge == 'staff' && isStaff()))
        && !chatMuted(matchId)
        && getAfter(/databases/$(database)/documents/matchChat/$(matchId)/authors/$(messageId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/matchChat/$(matchId)/authors/$(messageId)).data.createdAt == request.time
        // The pace record must be written in the same batch; its own rule enforces slow mode.
        && getAfter(/databases/$(database)/documents/matchChat/$(matchId)/pace/$(request.auth.uid)).data.messageId == messageId;
      allow delete: if activeStaff();
    }
    match /matchChat/{matchId}/authors/{messageId} {
      allow get, list: if activeStaff();
      allow create: if campusStudent()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/matchChat/$(matchId)/messages/$(messageId)).data.createdAt == request.time;
    }
    // One record per viewer per match: when they last posted. Slow mode (with a 2 second floor) is enforced here.
    match /matchChat/{matchId}/pace/{uid} {
      allow get: if ownsProfile(uid);
      allow create, update: if ownsProfile(uid) && campusStudent()
        && request.resource.data.keys().hasOnly(['lastMessageAt', 'messageId'])
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.messageId is string
        && getAfter(/databases/$(database)/documents/matchChat/$(matchId)/messages/$(request.resource.data.messageId)).data.createdAt == request.time
        && (resource == null || isStaff()
          || request.time >= resource.data.lastMessageAt + duration.value(chatSlowModeSec(matchId) > 2 ? chatSlowModeSec(matchId) : 2, 's'));
    }
    // Timed mutes and kicks. The muted viewer can read their own record to see the countdown.
    match /matchChat/{matchId}/mutes/{uid} {
      allow get: if ownsProfile(uid) || activeStaff();
      allow list: if activeStaff();
      allow create, update: if activeStaff() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['until', 'kind', 'reason', 'name', 'by', 'auditId', 'createdAt'])
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.kind in ['mute', 'kick']
        && request.resource.data.until is timestamp && request.resource.data.until > request.time
        && request.resource.data.until <= request.time + duration.value(24, 'h')
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
        && request.resource.data.by == request.auth.uid && request.resource.data.createdAt == request.time
        && auditedNow(request.resource.data.auditId);
      allow delete: if activeStaff();
    }
    function validEvidenceFile(file, caseId) {
      return file is map && file.keys().hasOnly(['path', 'name', 'mime', 'size'])
        && file.path is string && file.path.matches('integrityEvidence/' + request.auth.uid + '/' + caseId + '/[^/]+')
        && file.name is string && file.name.size() > 0 && file.name.size() <= 180
        && file.mime in ['image/png', 'image/jpeg', 'image/webp', 'video/mp4', 'video/webm']
        && file.size is int && file.size > 0 && file.size <= 104857600;
    }
    function validCase(data, caseId) {
      let files = data.get('evidenceFiles', []);
      return data.keys().hasOnly(['reporterId', 'matchId', 'reason', 'details', 'evidenceUrl', 'evidenceFiles', 'status', 'reviewerId', 'resolution', 'createdAt', 'updatedAt'])
        && data.reporterId == request.auth.uid
        && data.matchId is string && data.matchId.size() > 0 && data.matchId.size() <= 160
        && data.reason in ['Suspected cheating', 'Unregistered player', 'Account sharing', 'Score dispute', 'Unsportsmanlike conduct']
        && data.details is string && data.details.size() >= 30 && data.details.size() <= 3000
        && data.evidenceUrl is string && data.evidenceUrl.size() <= 1500
        && files is list && files.size() <= 3
        && (files.size() < 1 || validEvidenceFile(files[0], caseId))
        && (files.size() < 2 || validEvidenceFile(files[1], caseId))
        && (files.size() < 3 || validEvidenceFile(files[2], caseId))
        && ((files.size() > 0 && data.evidenceUrl == '') || data.evidenceUrl.matches('https://(www[.])?(youtube[.]com|youtu[.]be|drive[.]google[.]com|docs[.]google[.]com|streamable[.]com|imgur[.]com|i[.]imgur[.]com|clips[.]twitch[.]tv|twitch[.]tv)/[^ ]*'))
        && data.status == 'open' && data.reviewerId == '' && data.resolution == ''
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function caseRateLimit(caseId) {
      let path = /databases/$(database)/documents/integrityRateLimits/$(request.auth.uid);
      return (!exists(path) || request.time >= get(path).data.submittedAt + duration.value(60, 's'))
        && getAfter(path).data.submittedAt == request.time && getAfter(path).data.caseId == caseId;
    }
    match /integrityCases/{caseId} {
      allow read: if activeAccount() && (resource.data.reporterId == request.auth.uid || isStaff());
      allow create: if activeAccount() && validCase(request.resource.data, caseId) && caseRateLimit(caseId);
      allow update: if isStaff() && activeAccount()
        && resource.data.status in ['open', 'reviewing']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewerId', 'resolution', 'updatedAt'])
        && request.resource.data.status in ['reviewing', 'resolved', 'dismissed']
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.resolution is string && request.resource.data.resolution.size() >= 10 && request.resource.data.resolution.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /integrityRateLimits/{uid} {
      allow read: if ownsProfile(uid);
      allow create, update: if ownsProfile(uid) && activeAccount()
        && request.resource.data.keys().hasOnly(['submittedAt', 'caseId'])
        && request.resource.data.submittedAt == request.time
        && request.resource.data.caseId is string
        && (!exists(/databases/$(database)/documents/integrityRateLimits/$(uid)) || request.time >= resource.data.submittedAt + duration.value(60, 's'))
        && !exists(/databases/$(database)/documents/integrityCases/$(request.resource.data.caseId))
        && getAfter(/databases/$(database)/documents/integrityCases/$(request.resource.data.caseId)).data.reporterId == uid;
      allow delete: if false;
    }
    function admitted() { return campusStudent() || activeSpectator(); }
    function activeStaff() { return isStaff() && campusStudent(); }
    function validNotification(data) {
      return data.keys().hasOnly(['kind', 'title', 'body', 'tab', 'entityId', 'createdAt', 'readAt'])
        && data.kind in ['registration', 'check-in', 'fair-play', 'schedule', 'live', 'result', 'bracket']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() <= 500
        && data.tab in ['operations', 'integrity', 'schedule', 'current-live', 'brackets', 'reports']
        && data.entityId is string && data.entityId.size() <= 250
        && data.createdAt is timestamp && data.readAt == null;
    }
    match /users/{uid}/notifications/{id} {
      allow read: if ownsProfile(uid) && activeAccount();
      // An owner can copy permitted tournament announcements into their own inbox.
      allow create: if validNotification(request.resource.data) && ((ownsProfile(uid) && admitted()) || activeStaff());
      allow update: if ownsProfile(uid) && activeAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && (request.resource.data.readAt == request.time || request.resource.data.readAt == null);
    }
    match /arenaAnnouncements/{id} {
      allow read: if admitted();
      allow create: if activeStaff() && validNotification(request.resource.data) && request.resource.data.createdAt == request.time;
    }
    match /staffInbox/{id} {
      allow read: if activeStaff();
      allow create: if activeAccount() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'title', 'body', 'tab', 'entityId', 'createdAt', 'readAt', 'actorId', 'sourceId'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.tab in ['operations', 'integrity', 'reports']
        && request.resource.data.createdAt == request.time && request.resource.data.readAt == null
        && request.resource.data.entityId is string && request.resource.data.entityId.size() <= 250
        && ((request.resource.data.kind == 'registration' && campusStudent()
            && id == 'registration-' + request.resource.data.sourceId + '-' + string(getAfter(/databases/$(database)/documents/tournamentRegistrations/$(request.resource.data.sourceId)).data.revision)
            && getAfter(/databases/$(database)/documents/tournamentRegistrations/$(request.resource.data.sourceId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/tournamentRegistrations/$(request.resource.data.sourceId)).data.updatedAt == request.time)
          || (request.resource.data.kind == 'check-in' && campusStudent() && id == 'checkin-' + request.resource.data.sourceId + '-' + string(getAfter(/databases/$(database)/documents/matchCheckIns/$(request.resource.data.sourceId)).data.submissionRevision)
            && getAfter(/databases/$(database)/documents/matchCheckIns/$(request.resource.data.sourceId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/matchCheckIns/$(request.resource.data.sourceId)).data.updatedAt == request.time)
          || (request.resource.data.kind == 'fair-play' && id == 'case-' + request.resource.data.sourceId
            && getAfter(/databases/$(database)/documents/integrityCases/$(request.resource.data.sourceId)).data.reporterId == request.auth.uid
            && getAfter(/databases/$(database)/documents/integrityCases/$(request.resource.data.sourceId)).data.createdAt == request.time)
          || (request.resource.data.kind == 'fair-play' && id == 'appeal-' + request.resource.data.sourceId
            && getAfter(/databases/$(database)/documents/integrityCases/$(request.resource.data.sourceId)/appeals/appeal).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/integrityCases/$(request.resource.data.sourceId)/appeals/appeal).data.createdAt == request.time)
          || (request.resource.data.kind == 'fair-play' && id == 'community-' + request.resource.data.sourceId
            && getAfter(/databases/$(database)/documents/communityReports/$(request.resource.data.sourceId)).data.reporterId == request.auth.uid
            && getAfter(/databases/$(database)/documents/communityReports/$(request.resource.data.sourceId)).data.createdAt == request.time));
    }
    match /tournamentPolicies/{id} {
      allow read: if admitted();
      allow create, update: if activeStaff() && request.resource.data.keys().hasOnly(['tournamentId', 'gameId', 'playersRequired', 'maxSubstitutes', 'registrationOpen', 'updatedAt'])
        && request.resource.data.tournamentId == id && request.resource.data.gameId is string
        && request.resource.data.playersRequired is int && request.resource.data.playersRequired >= 1 && request.resource.data.playersRequired <= 8
        && request.resource.data.maxSubstitutes is int && request.resource.data.maxSubstitutes >= 0 && request.resource.data.maxSubstitutes <= 2
        && request.resource.data.playersRequired + request.resource.data.maxSubstitutes <= 8
        && request.resource.data.registrationOpen is bool && request.resource.data.updatedAt == request.time;
    }
    function validRosterPlayer(p) {
      return p is map && p.keys().hasOnly(['name', 'ign', 'studentId', 'accountId', 'substitute'])
        && p.name.matches('.{1,100}') && p.ign.matches('.{1,100}')
        && p.studentId.matches('.{1,100}') && p.accountId.matches('.{1,100}') && p.substitute is bool;
    }
    function validRoster(data) {
      return data.keys().hasOnly(['ownerId', 'tournamentId', 'teamId', 'teamName', 'gameId', 'college', 'players', 'status', 'revision', 'reviewNote', 'sanction', 'createdAt', 'updatedAt'])
        && data.teamId is string && data.teamId.size() > 0 && data.teamId.size() <= 160
        && data.teamName is string && data.teamName.size() > 0 && data.teamName.size() <= 120
        && data.tournamentId is string && data.tournamentId.size() > 0 && data.tournamentId.size() <= 160
        && data.college is string && data.college.size() > 0 && data.college.size() <= 100
        && data.players is list && data.players.size() >= 1 && data.players.size() <= 8
        && validRosterPlayer(data.players[0])
        && (data.players.size() < 2 || validRosterPlayer(data.players[1]))
        && (data.players.size() < 3 || validRosterPlayer(data.players[2]))
        && (data.players.size() < 4 || validRosterPlayer(data.players[3]))
        && (data.players.size() < 5 || validRosterPlayer(data.players[4]))
        && (data.players.size() < 6 || validRosterPlayer(data.players[5]))
        && (data.players.size() < 7 || validRosterPlayer(data.players[6]))
        && (data.players.size() < 8 || validRosterPlayer(data.players[7]))
        && data.revision is int && data.revision > 0 && data.updatedAt == request.time;
    }
    function openRegistration(data) {
      let policy = get(/databases/$(database)/documents/tournamentPolicies/$(data.tournamentId)).data;
      return policy.registrationOpen == true && policy.gameId == data.gameId
        && data.players.size() >= policy.playersRequired && data.players.size() <= policy.playersRequired + policy.maxSubstitutes;
    }
    match /tournamentRegistrations/{id} {
      allow get: if campusStudent() && (!exists(/databases/$(database)/documents/tournamentRegistrations/$(id)) || resource.data.ownerId == request.auth.uid || isStaff());
      allow list: if campusStudent() && (resource.data.ownerId == request.auth.uid || isStaff());
      allow create: if campusStudent() && validRoster(request.resource.data) && openRegistration(request.resource.data)
        && id == request.resource.data.tournamentId + '__' + request.resource.data.teamId
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'submitted'
        && request.resource.data.sanction == 'none' && request.resource.data.reviewNote == ''
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if campusStudent() && validRoster(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.tournamentId == resource.data.tournamentId && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.gameId == resource.data.gameId && request.resource.data.teamName == resource.data.teamName
        && ((resource.data.ownerId == request.auth.uid && resource.data.status in ['submitted', 'rejected']
            && openRegistration(request.resource.data) && request.resource.data.status == 'submitted'
            && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.reviewNote == ''
            && request.resource.data.sanction == resource.data.sanction)
          || (isStaff() && request.resource.data.revision == resource.data.revision
            && request.resource.data.players == resource.data.players && request.resource.data.college == resource.data.college
            && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 1000
            && request.resource.data.sanction in ['none', 'warning', 'disqualified']
            && ((resource.data.status in ['submitted', 'rejected'] && request.resource.data.status in ['approved', 'rejected'] && request.resource.data.reviewNote.size() >= 10)
              || (resource.data.status == 'approved' && request.resource.data.status == 'locked' && request.resource.data.reviewNote.size() >= 10)
              || (request.resource.data.status == resource.data.status && request.resource.data.reviewNote == resource.data.reviewNote))));
    }
    match /rosterRegistries/{id} { allow read, create, update: if activeStaff(); }
    match /matchWindows/{id} {
      allow read: if admitted();
      allow create, update: if activeStaff() && request.resource.data.keys().hasOnly(['matchId', 'tournamentId', 'registrationIds', 'opensAt', 'closesAt', 'updatedAt'])
        && request.resource.data.matchId == id && request.resource.data.tournamentId is string
        && request.resource.data.registrationIds is list && request.resource.data.registrationIds.size() == 2
        && request.resource.data.registrationIds[0] != request.resource.data.registrationIds[1]
        && request.resource.data.opensAt is timestamp && request.resource.data.closesAt is timestamp
        && request.resource.data.opensAt < request.resource.data.closesAt && request.resource.data.updatedAt == request.time;
    }
    function checkInOwner(data) {
      let roster = get(/databases/$(database)/documents/tournamentRegistrations/$(data.registrationId)).data;
      let window = get(/databases/$(database)/documents/matchWindows/$(data.matchId)).data;
      return roster.ownerId == request.auth.uid && data.ownerId == request.auth.uid && roster.status == 'locked'
        && roster.sanction != 'disqualified' && data.rosterRevision == roster.revision
        && data.tournamentId == roster.tournamentId && data.tournamentId == window.tournamentId
        && data.registrationId in window.registrationIds && request.time >= window.opensAt && request.time <= window.closesAt;
    }
    function validLineupRow(p) { return p is map && p.keys().hasOnly(['studentId', 'accountId']) && p.studentId is string && p.studentId.size() > 0 && p.studentId.size() <= 100 && p.accountId is string && p.accountId.size() > 0 && p.accountId.size() <= 100; }
    function validLineup(rows) {
      return rows.size() > 0 && validLineupRow(rows[0])
        && (rows.size() < 2 || validLineupRow(rows[1])) && (rows.size() < 3 || validLineupRow(rows[2]))
        && (rows.size() < 4 || validLineupRow(rows[3])) && (rows.size() < 5 || validLineupRow(rows[4]))
        && (rows.size() < 6 || validLineupRow(rows[5])) && (rows.size() < 7 || validLineupRow(rows[6])) && (rows.size() < 8 || validLineupRow(rows[7]));
    }
    match /matchCheckIns/{id} {
      allow get: if campusStudent() && (!exists(/databases/$(database)/documents/matchCheckIns/$(id)) || resource.data.ownerId == request.auth.uid || isStaff());
      allow list: if campusStudent() && (resource.data.ownerId == request.auth.uid || isStaff());
      allow create: if campusStudent()
        && request.resource.data.keys().hasOnly(['ownerId', 'registrationId', 'tournamentId', 'matchId', 'rosterRevision', 'submissionRevision', 'lineup', 'evidenceUrl', 'status', 'refereeNote', 'createdAt', 'updatedAt'])
        && request.resource.data.get('submissionRevision', 1) == 1
        && id == request.resource.data.matchId + '__' + request.resource.data.registrationId
        && request.resource.data.lineup is list && request.resource.data.lineup.size() <= 8
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ((checkInOwner(request.resource.data) && validLineup(request.resource.data.lineup) && request.resource.data.status == 'pending'
            && request.resource.data.lineup.size() >= 1 && request.resource.data.evidenceUrl is string && request.resource.data.evidenceUrl.size() <= 1500
            && request.resource.data.evidenceUrl.matches('https://(www[.])?(youtube[.]com|youtu[.]be|drive[.]google[.]com|docs[.]google[.]com|streamable[.]com|imgur[.]com|i[.]imgur[.]com|clips[.]twitch[.]tv|twitch[.]tv)/[^ ]*')
            && request.resource.data.refereeNote == '')
          || (isStaff() && request.resource.data.status == 'no-show' && request.resource.data.lineup.size() == 0
            && request.time > get(/databases/$(database)/documents/matchWindows/$(request.resource.data.matchId)).data.closesAt
            && request.resource.data.registrationId in get(/databases/$(database)/documents/matchWindows/$(request.resource.data.matchId)).data.registrationIds
            && request.resource.data.ownerId == get(/databases/$(database)/documents/tournamentRegistrations/$(request.resource.data.registrationId)).data.ownerId
            && request.resource.data.refereeNote is string && request.resource.data.refereeNote.size() >= 10 && request.resource.data.refereeNote.size() <= 1000));
      allow update: if activeStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'refereeNote', 'updatedAt'])
        && request.resource.data.status in ['confirmed', 'disputed', 'no-show']
        && request.resource.data.refereeNote is string && request.resource.data.refereeNote.size() >= 10 && request.resource.data.refereeNote.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow update: if campusStudent() && resource.data.ownerId == request.auth.uid && resource.data.status == 'disputed'
        && checkInOwner(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineup', 'evidenceUrl', 'status', 'refereeNote', 'submissionRevision', 'updatedAt'])
        && request.resource.data.submissionRevision == resource.data.get('submissionRevision', 1) + 1
        && request.resource.data.status == 'pending' && request.resource.data.refereeNote == '' && request.resource.data.updatedAt == request.time
        && request.resource.data.lineup is list && request.resource.data.lineup.size() <= 8 && validLineup(request.resource.data.lineup)
        && request.resource.data.evidenceUrl is string && request.resource.data.evidenceUrl.size() <= 1500
        && request.resource.data.evidenceUrl.matches('https://(www[.])?(youtube[.]com|youtu[.]be|drive[.]google[.]com|docs[.]google[.]com|streamable[.]com|imgur[.]com|i[.]imgur[.]com|clips[.]twitch[.]tv|twitch[.]tv)/[^ ]*')
        && getAfter(/databases/$(database)/documents/matchCheckIns/$(id)/submissions/$(string(resource.data.get('submissionRevision', 1)))).data.previous == resource.data;
    }
    match /matchCheckIns/{id}/submissions/{revision} {
      allow read: if campusStudent() && (isStaff() || get(/databases/$(database)/documents/matchCheckIns/$(id)).data.ownerId == request.auth.uid);
      allow create: if campusStudent() && request.resource.data.keys().hasOnly(['previous', 'actorId', 'savedAt'])
        && request.resource.data.actorId == request.auth.uid && request.resource.data.savedAt == request.time
        && get(/databases/$(database)/documents/matchCheckIns/$(id)).data.ownerId == request.auth.uid
        && revision == string(get(/databases/$(database)/documents/matchCheckIns/$(id)).data.get('submissionRevision', 1))
        && request.resource.data.previous == get(/databases/$(database)/documents/matchCheckIns/$(id)).data
        && getAfter(/databases/$(database)/documents/matchCheckIns/$(id)).data.submissionRevision == int(revision) + 1;
    }
    match /auditEvents/{id} {
      allow read: if activeStaff();
      allow create: if activeStaff() && request.resource.data.keys().hasOnly(['actorId', 'action', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid && request.resource.data.action is string && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 1500
        && request.resource.data.createdAt == request.time;
    }
    match /tournamentSanctions/{id} {
      allow read: if activeStaff() || (campusStudent() && resource.data.ownerId == request.auth.uid);
      allow create: if activeStaff() && request.resource.data.keys().hasOnly(['registrationId', 'tournamentId', 'ownerId', 'caseId', 'sanction', 'note', 'actorId', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.sanction in ['none', 'warning', 'disqualified'] && request.resource.data.note is string && request.resource.data.note.size() >= 10 && request.resource.data.note.size() <= 1000
        && get(/databases/$(database)/documents/integrityCases/$(request.resource.data.caseId)).data.status == 'resolved'
        && request.resource.data.ownerId == get(/databases/$(database)/documents/tournamentRegistrations/$(request.resource.data.registrationId)).data.ownerId;
    }
    match /communityReports/{id} {
      allow read: if activeStaff();
      allow create: if campusStudent() && request.resource.data.keys().hasOnly(['reporterId', 'matchId', 'sourceMessageId', 'contentSnippet', 'postedBy', 'type', 'status', 'reviewerId', 'resolution', 'createdAt', 'updatedAt'])
        && request.resource.data.reporterId == request.auth.uid
        && id == request.resource.data.matchId + '__' + request.resource.data.sourceMessageId + '__' + request.auth.uid
        && request.resource.data.type == 'HARASSMENT' && request.resource.data.status == 'open' && request.resource.data.reviewerId == '' && request.resource.data.resolution == ''
        && request.resource.data.contentSnippet == get(/databases/$(database)/documents/matchChat/$(request.resource.data.matchId)/messages/$(request.resource.data.sourceMessageId)).data.text
        && request.resource.data.postedBy == get(/databases/$(database)/documents/matchChat/$(request.resource.data.matchId)/messages/$(request.resource.data.sourceMessageId)).data.author
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if activeStaff() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewerId', 'resolution', 'updatedAt'])
        && request.resource.data.status == 'resolved' && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.resolution in ['remove', 'remove_and_ban', 'dismiss'] && request.resource.data.updatedAt == request.time;
    }
    function caseReader(caseId) { return activeAccount() && (isStaff() || get(/databases/$(database)/documents/integrityCases/$(caseId)).data.reporterId == request.auth.uid); }
    match /integrityCases/{caseId}/events/{id} {
      allow read: if caseReader(caseId);
      allow create: if activeStaff() && exists(/databases/$(database)/documents/integrityCases/$(caseId))
        && request.resource.data.keys().hasOnly(['actorId', 'action', 'note', 'frames', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.action in ['reviewing', 'resolved', 'dismissed', 'video-review', 'appeal-accepted', 'appeal-rejected']
        && request.resource.data.note is string && request.resource.data.note.size() >= 10 && request.resource.data.note.size() <= 2000
        && request.resource.data.get('frames', []) is list && request.resource.data.get('frames', []).size() <= 60;
    }
    match /integrityCases/{caseId}/appeals/{id} {
      allow read: if caseReader(caseId);
      allow create: if id == 'appeal' && activeAccount() && request.resource.data.keys().hasOnly(['ownerId', 'note', 'status', 'resolution', 'createdAt', 'updatedAt'])
        && get(/databases/$(database)/documents/integrityCases/$(caseId)).data.reporterId == request.auth.uid
        && get(/databases/$(database)/documents/integrityCases/$(caseId)).data.status in ['resolved', 'dismissed']
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'open' && request.resource.data.resolution == ''
        && request.resource.data.note is string && request.resource.data.note.size() >= 10 && request.resource.data.note.size() <= 2000
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if activeStaff() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected'] && request.resource.data.resolution is string && request.resource.data.resolution.size() >= 10 && request.resource.data.resolution.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
